    {
      "type": "node",
      "request": "launch",
      "name": "Debug: run-agent",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "examples/run-agent.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
